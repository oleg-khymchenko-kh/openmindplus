generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commands  AgentCommand[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

model TeamMember {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  role        String
  department  String   // "engineering" | "content"
  bio         String?
  photoUrl    String?  @map("photo_url")
  linkedinUrl String?  @map("linkedin_url")
  instagramUrl String? @map("instagram_url")
  xUrl        String?  @map("x_url")
  telegramUrl String?  @map("telegram_url")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects    ProjectMember[]

  @@map("team_members")
}

model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  url         String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     ProjectMember[]
  agents      Agent[]

  @@map("projects")
}

model ProjectMember {
  project     Project    @relation(fields: [projectId], references: [id])
  projectId   Int        @map("project_id")
  member      TeamMember @relation(fields: [memberId], references: [id])
  memberId    Int        @map("member_id")

  @@id([projectId, memberId])
  @@map("project_members")
}

model Agent {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  botToken     String   @map("bot_token")        // Telegram bot token
  botUsername  String?  @map("bot_username")     // @username
  chatId       String?  @map("chat_id")          // Default chat to send messages to
  project      Project? @relation(fields: [projectId], references: [id])
  projectId    Int?     @map("project_id")
  parent       Agent?   @relation("AgentHierarchy", fields: [parentId], references: [id])
  parentId     Int?     @map("parent_id")
  children     Agent[]  @relation("AgentHierarchy")
  posX         Float    @default(0) @map("pos_x") // Visual position on canvas
  posY         Float    @default(0) @map("pos_y")
  color        String   @default("#3b82f6")       // Node color on canvas
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  commands     AgentCommand[]

  @@map("agents")
}

model AgentCommand {
  id        Int      @id @default(autoincrement())
  agent     Agent    @relation(fields: [agentId], references: [id])
  agentId   Int      @map("agent_id")
  sentBy    User     @relation(fields: [sentById], references: [id])
  sentById  Int      @map("sent_by_id")
  message   String
  response  String?
  status    CommandStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("agent_commands")
}

enum CommandStatus {
  PENDING
  SENT
  FAILED
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
